{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "neverlost.cli.vector.v1",
  "title": "NeverLost CLI vector",
  "type": "object",
  "required": [
    "schema",
    "name",
    "kind"
  ],
  "properties": {
    "schema": {
      "const": "neverlost.cli.vector.v1"
    },
    "name": {
      "type": "string",
      "pattern": "^[a-z0-9_]+$"
    },
    "kind": {
      "enum": [
        "positive_lifecycle",
        "negative_single",
        "sequence"
      ]
    },
    "area": {
      "type": "string"
    },
    "action": {
      "type": "string"
    },
    "expect_exit": {
      "type": "integer"
    },
    "expect_contains": {
      "type": "string"
    },
    "setup": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "write_files": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "remove_files": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "area",
          "action",
          "expect_exit"
        ],
        "properties": {
          "area": {
            "type": "string"
          },
          "action": {
            "type": "string"
          },
          "expect_exit": {
            "type": "integer"
          },
          "expect_contains": {
            "type": "string"
          },
          "expect_stdout_contains": {
            "type": "string"
          }
        }
      }
    }
  }
}
