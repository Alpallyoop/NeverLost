{
  "schema": "neverlost.cli.vector.v1",
  "name": "negative_replay_confirm_after_end",
  "kind": "sequence",
  "steps": [
    {
      "area": "authority",
      "action": "start",
      "expect_exit": 0,
      "expect_contains": "AUTHORITY_STARTED_OK"
    },
    {
      "area": "authority",
      "action": "end",
      "expect_exit": 0,
      "expect_contains": "AUTHORITY_ENDED_OK"
    },
    {
      "area": "authority",
      "action": "confirm",
      "expect_exit": 1,
      "expect_contains": "SESSION_NOT_ACTIVE"
    },
    {
      "area": "authority",
      "action": "end",
      "expect_exit": 1,
      "expect_contains": "SESSION_NOT_ACTIVE"
    }
  ]
}
