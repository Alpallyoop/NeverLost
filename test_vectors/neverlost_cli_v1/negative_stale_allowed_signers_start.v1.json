      "proofs/trust/allowed_signers": "single-tenant/operator/x/stale namespaces=\"watchtower\" ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHBI4Mqg+vdDmY+YyoNDBebHsx7MWrsiOj16587famX/\n"
    }
  },
  "steps": [
